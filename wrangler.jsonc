{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "designoirs-sol",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [{ "binding": "DB","database_id": "828ca96c-bc18-444a-b3bd-04530f1a67a3","database_name": "designoirs" }],
  "r2_buckets": [{ "binding": "BUCKET","bucket_name": "designoirs","preview_bucket_name": "designoirs" }]
}
